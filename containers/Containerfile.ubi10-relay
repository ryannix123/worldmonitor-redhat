# =============================================================================
# World Monitor AIS Relay — UBI 10 / Node.js 24
# =============================================================================
# The relay is a single long-running Node process (scripts/ais-relay.cjs) that
# holds a websocket to aisstream.io, polls OpenSky for aircraft, proxies RSS,
# and warms Redis caches the dashboard reads. It listens on 3004.
#
# Much simpler than the main image: no nginx, no static build, no sidecar — one
# Node process. So this is a single-stage build on ubi10/nodejs-24 with the
# relay's runtime dependencies installed.
#
# OpenShift arbitrary-UID support is the same pattern as the main image:
# group-0 ownership, group-writable, numeric USER.
# =============================================================================

ARG NODE_IMAGE=registry.access.redhat.com/ubi10/nodejs-24:latest

FROM ${NODE_IMAGE} AS builder

USER 0
WORKDIR /build

# The relay imports a subset of the app's dependencies. Installing the full
# production graph is wasteful but reliable — the relay's exact dependency
# closure is not separately declared upstream. If image size matters later,
# prune to the relay's actual imports.
COPY package.json package-lock.json ./

# Install the relay's runtime dependencies. tar 7.5.15 comes in transitively
# and carries CVE-2026-59873 (a decompression/parse DoS in node-tar). We do NOT
# force-patch it here: the relay is a network gateway (AIS/OpenSky/Telegram/RSS)
# that never extracts tar archives, so the vulnerable code path is unreachable.
# That not-affected assessment is documented in containers/relay.openvex.json
# and applied at scan time via .grype.yaml. See README "On the CVE story".
RUN npm ci --omit=dev --ignore-scripts

# The relay's requireShared() loads scripts/shared/inventory-facts.generated.json,
# a build artifact upstream deliberately does not commit. The same generator the
# app image runs writes it (plus api/_inventory-facts.generated.js and
# docs/generated/stats.json) from the tracked shared/product-facts.generated.json.
# Copy the tree in AFTER npm ci so dependency installs stay cached, run the
# generator here, and let the runtime stage copy scripts/ and shared/ from this
# stage — the same pattern as upstream's own Dockerfile.
COPY . .
RUN node scripts/generate-inventory-facts.mjs

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS final

ARG VERSION=dev
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="World Monitor AIS Relay (UBI 10)" \
      org.opencontainers.image.description="AIS/OpenSky/RSS relay for World Monitor on Red Hat UBI 10" \
      org.opencontainers.image.source="https://github.com/koala73/worldmonitor" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      io.openshift.expose-services="3004:http" \
      io.openshift.tags="worldmonitor,relay,ais,nodejs"

USER 0
WORKDIR /app

# node_modules from the builder, plus the relay script and its lib deps.
COPY --from=builder /build/node_modules ./node_modules
# scripts/ and shared/ come from the BUILDER stage, not the build context, so
# they include the generated inventory-facts JSON the relay requires at start.
# ais-relay.cjs requires both `./shared/*.cjs` (under scripts/) and
# `../shared/*.js` (top-level, added upstream ~Sep 2026: chokepoint-traffic-
# anomaly, chokepoint-threat-levels, ais-vessel-type, corridor-risk,
# ais-watchdog), so shared/ must sit BESIDE scripts/ under /app.
COPY --from=builder /build/scripts ./scripts
COPY --from=builder /build/shared ./shared
COPY package.json ./

# Arbitrary-UID: group-0 ownership + group-writable on the app dir.
RUN chgrp -R 0 /app && chmod -R g=u /app

# --- Self-hosted API base redirect ------------------------------------------
# The relay hardcodes its warm-ping / RPC targets to api.worldmonitor.app with
# no env override (CII_RPC_URL, CHOKEPOINT_RPC_URL, CABLE_HEALTH_RPC_URL,
# SERVICE_STATUSES_RPC_URL). In a self-hosted deployment those calls hit
# upstream's production gateway and 401 — the relay key is validated against
# THEIR WORLDMONITOR_RELAY_KEY, not yours.
#
# This preload shim rewrites the origin at the fetch layer, so it catches
# string literals, template literals, and URL/Request objects alike without
# patching upstream source. It is a strict no-op when WM_INTERNAL_API_BASE is
# unset, so the default behavior is identical to upstream.
#
# Written inline (printf, not COPY) so the build has no external file
# dependency that could go missing from the build context.
RUN printf '%s\n' \
  "const TARGET = 'https://api.worldmonitor.app';" \
  "const BASE = process.env.WM_INTERNAL_API_BASE;" \
  "if (BASE) {" \
  "  const orig = globalThis.fetch;" \
  "  globalThis.fetch = function (input, init) {" \
  "    try {" \
  "      if (typeof input === 'string' && input.startsWith(TARGET)) {" \
  "        input = BASE + input.slice(TARGET.length);" \
  "      } else if (input instanceof URL && input.origin === TARGET) {" \
  "        input = new URL(input.pathname + input.search + input.hash, BASE);" \
  "      } else if (input && typeof input === 'object' && typeof input.url === 'string' && input.url.startsWith(TARGET)) {" \
  "        input = new Request(BASE + input.url.slice(TARGET.length), input);" \
  "      }" \
  "    } catch {}" \
  "    return orig.call(this, input, init);" \
  "  };" \
  "  console.log('[wm-shim] rewriting ' + TARGET + ' -> ' + BASE);" \
  "}" \
  > /app/wm-api-base-shim.cjs \
 && chgrp 0 /app/wm-api-base-shim.cjs && chmod g=u /app/wm-api-base-shim.cjs \
 && node --check /app/wm-api-base-shim.cjs

# --- SRH path-style Redis GET compatibility ---------------------------------
# readCachedJson() reads Redis with a PATH-style request:
#     fetch(`${UPSTASH_REDIS_REST_URL}/get/${encodeURIComponent(key)}`)
# Upstash's hosted REST API serves that form. The self-hosted stand-in
# (serverless-redis-http / SRH) implements ONLY the POST-command form and
# returns 404 "SRH: Endpoint not found" for every path-style route — verified
# against /get/<key>, /dbsize and /ping.
#
# readCachedJson treats that 404 as a cache miss and its callers fall back to
# empty results, so every Redis-backed panel renders as "no data" even though
# the seeders wrote the data correctly. Security Advisories was the clearest
# case: 219 advisories in Redis, panel showing 0.
#
# This preload rewrites path-style GETs against the Redis REST base into the
# POST command form SRH accepts. Non-Redis fetches and existing POSTs are
# untouched, and the whole shim is a no-op if UPSTASH_REDIS_REST_URL is unset.
RUN printf '%s\n' \
  "const BASE = process.env.UPSTASH_REDIS_REST_URL;" \
  "const TOKEN = process.env.UPSTASH_REDIS_REST_TOKEN;" \
  "if (BASE) {" \
  "  const orig = globalThis.fetch;" \
  "  const base = BASE.replace(/\\/+\$/, '');" \
  "  globalThis.fetch = function (input, init) {" \
  "    try {" \
  "      const url = typeof input === 'string' ? input : (input instanceof URL ? input.href : (input && typeof input.url === 'string' ? input.url : null));" \
  "      if (url && url.startsWith(base + '/')) {" \
  "        const parts = url.slice(base.length + 1).split('/').filter(Boolean).map(decodeURIComponent);" \
  "        const method = ((init && init.method) || 'GET').toUpperCase();" \
  "        if (method === 'GET' && parts.length) {" \
  "          const auth = (init && init.headers && (init.headers.Authorization || init.headers.authorization)) || (TOKEN ? 'Bearer ' + TOKEN : undefined);" \
  "          return orig.call(this, base, { method: 'POST', headers: Object.assign({ 'Content-Type': 'application/json' }, auth ? { Authorization: auth } : {}), body: JSON.stringify(parts), signal: init && init.signal });" \
  "        }" \
  "      }" \
  "    } catch {}" \
  "    return orig.call(this, input, init);" \
  "  };" \
  "  console.log('[srh-shim] path-style Redis GETs -> POST command form');" \
  "}" \
  > /app/srh-compat-shim.cjs \
 && chgrp 0 /app/srh-compat-shim.cjs && chmod g=u /app/srh-compat-shim.cjs \
 && node --check /app/srh-compat-shim.cjs

USER 1001

EXPOSE 3004

# The relay exposes /metrics (RELAY_METRICS_WINDOW_SECONDS). A TCP connect is
# the safe cross-version liveness signal — a specific path might change, but
# "is it listening on 3004" is the thing that matters. The Deployment's own
# probes supersede this in OpenShift.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/usr/bin/node", "-e", "require('node:net').connect(3004,'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))"]

# scripts/ais-relay.cjs reads PORT (default 3004 in the compose) and the
# AISSTREAM/OPENSKY/relay-secret env vars. The Deployment provides those.
CMD ["node", "--require", "/app/wm-api-base-shim.cjs", "scripts/ais-relay.cjs"]
