# User unit (lives beside the Quadlet-generated openclaw.service). Registers the
# agent's scheduled jobs once the gateway is healthy; idempotent, so it runs on
# every boot and after every image update without harm.
[Unit]
Description=OpenClaw — register World Monitor automations
Requires=openclaw.service
After=openclaw.service

[Service]
Type=oneshot
ExecStart=%h/.config/worldmonitor/openclaw/register-automations.sh
# The gateway needs a moment after "healthy" before its CLI socket answers.
ExecStartPre=/bin/sleep 15

[Install]
WantedBy=default.target
