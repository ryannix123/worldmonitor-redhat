# OpenClaw agent on the World Monitor NUC. Rendered by install.sh into
# ~wm/.config/worldmonitor/openclaw.env (mode 600); edit there, then
# `systemctl --user restart openclaw`.

# Shows the chat as the kiosk's second tab (Ctrl-Tab from the wall).
# 0 = the hourly SITREP still runs, nothing visible — the phase-one default.
OPENCLAW_UI=0

# Control UI secret. Only this box's browser ever presents it (18789 is bound
# to localhost). Generated.
OPENCLAW_GATEWAY_TOKEN=

# The World Monitor MCP key this agent presents (X-WorldMonitor-Key). It is a
# SECOND entry in World Monitor's WORLDMONITOR_VALID_KEYS, so it can be revoked
# without touching the relay's own key. Generated.
OPENCLAW_MCP_KEY_WORLDMONITOR=

# The model, as an OpenAI-compatible endpoint. Default is OpenRouter with the
# same spend-capped key World Monitor uses. Switching to Purdue GenAI Studio is
# these three lines and a restart — nothing else changes.
#   OpenRouter: https://openrouter.ai/api/v1  + a model id from openrouter.ai/models
#   Purdue:     https://genai.rcac.purdue.edu/api  + the model name it lists
OPENCLAW_OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENCLAW_OPENAI_MODEL=anthropic/claude-haiku-4.5
OPENCLAW_OPENAI_API_KEY=

# Rendered from openclaw/mcp-servers.json by install.sh (single-line JSON).
OPENCLAW_MCP_SERVERS=
