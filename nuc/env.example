# World Monitor appliance — secrets and API keys.
# install.sh creates ~wm/.config/worldmonitor/.env from this (mode 600) and
# fills in the generated values. Every container reads this file.
#
# --- Generated by install.sh — leave blank here -------------------------------
REDIS_PASSWORD=
REDIS_TOKEN=
WM_SESSION_SECRET=
WORLDMONITOR_VALID_KEYS=
RELAY_SHARED_SECRET=
# Derived from the above by install.sh (Quadlet cannot expand ${VAR}):
SRH_TOKEN=
SRH_CONNECTION_STRING=
UPSTASH_REDIS_REST_TOKEN=
WORLDMONITOR_RELAY_KEY=

# --- Required: AI briefs --------------------------------------------------------
# Use a DEDICATED OpenRouter key with a hard spend limit, so it can be revoked
# without touching anything else. Typical spend for this stack: ~$1–3/month.
OPENROUTER_API_KEY=

# --- Optional: data sources (panels degrade gracefully without them) -----------
UCDP_ACCESS_TOKEN=
AISSTREAM_API_KEY=
ACLED_EMAIL=
ACLED_PASSWORD=
FINNHUB_API_KEY=
FRED_API_KEY=
GROQ_API_KEY=
